stroke=\"currentColor\" stroke-width=\"1.6\"/><circle cx=\"30\" cy=\"174\" r=\"2.5\" fill=\"currentColor\"/><rect x=\"50\" y=\"150\" width=\"310\" height=\"48\" rx=\"7\" fill=\"var(--surface)\" stroke=\"#3f7fb0\" stroke-width=\"2\"/><text x=\"62\" y=\"171\" font-size=\"12.5\" font-weight=\"bold\" fill=\"currentColor\">② プラスチック類</text><text x=\"348\" y=\"171\" font-size=\"11.5\" font-weight=\"bold\" fill=\"#3f7fb0\" text-anchor=\"end\">週1回</text><text x=\"62\" y=\"188\" font-size=\"10.5\" fill=\"currentColor\" opacity=\"0.85\">食品容器・ボトル等</text><line x1=\"30\" y1=\"232\" x2=\"50\" y2=\"232\" stroke=\"currentColor\" stroke-width=\"1.6\"/><circle cx=\"30\" cy=\"232\" r=\"2.5\" fill=\"currentColor\"/><rect x=\"50\" y=\"208\" width=\"310\" height=\"48\" rx=\"7\" fill=\"var(--surface)\" stroke=\"#2e8b57\" stroke-width=\"2\"/><text x=\"62\" y=\"229\" font-size=\"12.5\" font-weight=\"bold\" fill=\"currentColor\">③ かん・びん／紙・布</text><text x=\"348\" y=\"229\" font-size=\"11.5\" font-weight=\"bold\" fill=\"#2e8b57\" text-anchor=\"end\">月2回</text><text x=\"62\" y=\"246\" font-size=\"10.5\" fill=\"currentColor\" opacity=\"0.85\">ペットボトル・小型不燃ごみ等</text><line x1=\"20\" y1=\"274\" x2=\"360\" y2=\"274\" stroke=\"currentColor\" stroke-width=\"1\" stroke-dasharray=\"3 3\" opacity=\"0.5\"/><text x=\"190\" y=\"290\" font-size=\"10.5\" fill=\"currentColor\" text-anchor=\"middle\" opacity=\"0.75\">特別な出し方が必要なもの</text><line x1=\"30\" y1=\"324\" x2=\"50\" y2=\"324\" stroke=\"currentColor\" stroke-width=\"1.6\"/><circle cx=\"30\" cy=\"324\" r=\"2.5\" fill=\"currentColor\"/><rect x=\"50\" y=\"300\" width=\"310\" height=\"48\" rx=\"7\" fill=\"var(--surface)\" stroke=\"#4a3f8f\" stroke-width=\"2\"/><text x=\"62\" y=\"321\" font-size=\"12.5\" font-weight=\"bold\" fill=\"currentColor\">④ 粗大ごみ</text><text x=\"348\" y=\"321\" font-size=\"11.5\" font-weight=\"bold\" fill=\"#4a3f8f\" text-anchor=\"end\">要申込</text><text x=\"62\" y=\"338\" font-size=\"10.5\" fill=\"currentColor\" opacity=\"0.85\">ネット受付／クリーンセンター持込</text><line x1=\"30\" y1=\"382\" x2=\"50\" y2=\"382\" stroke=\"currentColor\" stroke-width=\"1.6\"/><circle cx=\"30\" cy=\"382\" r=\"2.5\" fill=\"currentColor\"/><rect x=\"50\" y=\"358\" width=\"310\" height=\"48\" rx=\"7\" fill=\"var(--surface)\" stroke=\"#888\" stroke-width=\"2\" stroke-dasharray=\"6 4\"/><text x=\"62\" y=\"379\" font-size=\"12.5\" font-weight=\"bold\" fill=\"currentColor\">⑤ 収集できないごみ</text><text x=\"348\" y=\"379\" font-size=\"11.5\" font-weight=\"bold\" fill=\"#888\" text-anchor=\"end\">要問合せ</text><text x=\"62\" y=\"396\" font-size=\"10.5\" fill=\"currentColor\" opacity=\"0.85\">消火器・タイヤ等→クリーンセンターへ</text></svg><p class=\"guide-map-caption\">①〜③は毎回の収集日、④⑤は個別の申込・問い合わせが必要です（並列の分類で、優先順位ではありません）</p></div>",
        "<strong>燃やすごみ</strong>：週2回収集",
        "<strong>プラスチック類</strong>：週1回収集",
        "<strong>かん・びん／紙・布／ペットボトル／小型不燃ごみ</strong>：月2回収集"
      ]
